---
// src/components/ErrorScreen.astro
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import SEO from './SEO.astro';

export interface Props {
  code: string;
  category: string;
  titleEs: string;
  titleEn: string;
  descEs: string;
  descEn: string;
  diagEs: string;
  diagEn: string;
  suggestedCmd?: string;
  httpStatus: string;
}

const {
  code,
  category,
  titleEs,
  titleEn,
  descEs,
  descEn,
  diagEs,
  diagEn,
  suggestedCmd = 'cd ~ && nacel status',
  httpStatus,
} = Astro.props;

const baseUrl = (import.meta.env.BASE_URL && import.meta.env.BASE_URL !== '/') ? import.meta.env.BASE_URL : '';
const pageTitle = `${code} ${titleEs} — Nacel.AI`;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="icon" href={`${baseUrl}/favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, follow" />
    <SEO title={pageTitle} description={descEs} />
  </head>
  <body>
    <div class="bg-grid-overlay"></div>

    <Navbar />

    <main class="error-canvas">
      <div class="error-container">
        
        <!-- Category Pill & Status Code -->
        <div class="error-header-group">
          <div class="error-category-pill font-mono">
            <span class="error-dot"></span>
            <span>{category}</span>
          </div>
          <div class="error-code-monument font-mono">
            <span class="code-number">{code}</span>
          </div>
          <h1 class="error-title" id="err-title" data-title-es={titleEs} data-title-en={titleEn}>
            {titleEs}
          </h1>
          <p class="error-desc" id="err-desc" data-desc-es={descEs} data-desc-en={descEn}>
            {descEs}
          </p>
        </div>

        <!-- Terminal Error Interception Aperture -->
        <div class="error-terminal font-mono">
          <div class="terminal-bar">
            <div class="terminal-controls">
              <span class="control-dot red"></span>
              <span class="control-dot yellow"></span>
              <span class="control-dot green"></span>
            </div>
            <div class="terminal-title">TERMINAL TRACE // {httpStatus}</div>
            <div class="terminal-tag">STATUS {code}</div>
          </div>

          <div class="terminal-body">
            <div class="t-line input-line">
              <span class="t-prompt">danniel@dev-mbp ~/nacel %</span>
              <span class="t-cmd">curl -I {Astro.url.href}</span>
            </div>
            <div class="t-line error-line">
              <span class="t-err">{httpStatus}</span>
            </div>
            <div class="t-line muted">
              <span>x-nacel-trace: zero-telemetry-active // host-local</span>
            </div>

            <!-- Nacel Auto Intervention -->
            <div class="nacel-error-aperture">
              <div class="aperture-header">
                <span class="aperture-dot"></span>
                <span class="aperture-title">NACEL COPILOT [AUTO-DIAGNÓSTICO]</span>
              </div>
              <div class="aperture-content">
                <span class="diag-label">⚡ Causa Raíz:</span>
                <span class="diag-text" id="err-diag" data-diag-es={diagEs} data-diag-en={diagEn}>
                  {diagEs}
                </span>
              </div>
              <div class="aperture-solution">
                <span class="sol-label">&gt; Recuperación Sugerida:</span>
                <code class="sol-command">{suggestedCmd}</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Actions -->
        <div class="error-actions">
          <a href={`${baseUrl || '/'}`} class="action-btn primary font-mono">
            <span class="btn-icon">↵</span>
            <span id="btn-home-text">cd ~ / Volver al Inicio</span>
          </a>
          <a href="https://github.com/dannielnavas/nacel/issues" target="_blank" rel="noopener noreferrer" class="action-btn secondary font-mono">
            <span>Reportar Issue en GitHub →</span>
          </a>
        </div>

      </div>
    </main>

    <Footer />

    <!-- Language synchronization script -->
    <script is:inline>
      function syncErrorLang() {
        const lang = localStorage.getItem('nacel_lang') || 'es';
        const titleEl = document.getElementById('err-title');
        const descEl = document.getElementById('err-desc');
        const diagEl = document.getElementById('err-diag');
        const btnHome = document.getElementById('btn-home-text');

        if (titleEl) {
          titleEl.textContent = lang === 'en' ? titleEl.getAttribute('data-title-en') : titleEl.getAttribute('data-title-es');
        }
        if (descEl) {
          descEl.textContent = lang === 'en' ? descEl.getAttribute('data-desc-en') : descEl.getAttribute('data-desc-es');
        }
        if (diagEl) {
          diagEl.textContent = lang === 'en' ? diagEl.getAttribute('data-diag-en') : diagEl.getAttribute('data-diag-es');
        }
        if (btnHome) {
          btnHome.textContent = lang === 'en' ? 'cd ~ / Return to Home' : 'cd ~ / Volver al Inicio';
        }
      }

      syncErrorLang();

      // Listen for language toggles from Navbar
      document.getElementById('btn-es')?.addEventListener('click', () => setTimeout(syncErrorLang, 50));
      document.getElementById('btn-en')?.addEventListener('click', () => setTimeout(syncErrorLang, 50));
    </script>
  </body>
</html>

<style>
  .error-canvas {
    position: relative;
    z-index: 1;
    min-height: calc(100vh - 220px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }

  .error-container {
    max-width: 820px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-header-group {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    border-radius: 999px;
    font-size: 0.75rem;
    color: #fb7185;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .error-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f43f5e;
    box-shadow: 0 0 8px #f43f5e;
  }

  .error-code-monument {
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--text-pure);
    position: relative;
    user-select: none;
    background: linear-gradient(180deg, #ffffff 40%, rgba(255, 255, 255, 0.15) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 60px rgba(244, 63, 94, 0.15);
  }

  .error-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: 1rem;
    margin-bottom: 0.75rem;
  }

  .error-desc {
    color: var(--text-steel);
    font-size: 1.05rem;
    max-width: 580px;
    line-height: 1.6;
  }

  /* ── Terminal Error Box ────────────────────────────── */
  .error-terminal {
    width: 100%;
    background: #07070a;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .terminal-bar {
    background: #0b0c11;
    border-bottom: 1px solid var(--hairline);
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
  }

  .control-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .control-dot.red { background: #ff5f56; }
  .control-dot.yellow { background: #ffbd2e; }
  .control-dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-dim);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .terminal-tag {
    color: #fb7185;
    background: rgba(244, 63, 94, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.65rem;
  }

  .terminal-body {
    padding: 1.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .t-line {
    margin-bottom: 0.35rem;
  }

  .t-prompt {
    color: var(--text-dim);
    margin-right: 0.5rem;
  }

  .t-cmd {
    color: var(--text-pure);
    font-weight: 600;
  }

  .error-line {
    color: #fb7185;
  }

  .muted {
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .nacel-error-aperture {
    margin-top: 1.25rem;
    padding: 1.25rem;
    background: rgba(244, 63, 94, 0.02);
    border-left: 2px solid #f43f5e;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    border-radius: 0 4px 4px 0;
  }

  .aperture-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .aperture-dot {
    width: 6px;
    height: 6px;
    background: #f43f5e;
    border-radius: 50%;
    box-shadow: 0 0 8px #f43f5e;
  }

  .aperture-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fb7185;
  }

  .aperture-content {
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .diag-label {
    color: var(--text-pure);
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .diag-text {
    color: var(--text-platinum);
  }

  .aperture-solution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--hairline);
    font-size: 0.8rem;
  }

  .sol-label {
    color: var(--text-dim);
  }

  .sol-command {
    background: #11121b;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--hairline-bright);
    border-radius: 4px;
    color: var(--accent-cyan);
  }

  /* ── Error Actions ─────────────────────────────────── */
  .error-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 4px;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .action-btn.primary {
    background: #ffffff;
    color: #000000;
    font-weight: 600;
  }

  .action-btn.primary:hover {
    background: #e4e4e7;
    transform: translateY(-1px);
  }

  .action-btn.secondary {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--hairline);
    color: var(--text-steel);
  }

  .action-btn.secondary:hover {
    color: var(--text-pure);
    border-color: var(--hairline-bright);
    background: rgba(255, 255, 255, 0.06);
  }
</style>
