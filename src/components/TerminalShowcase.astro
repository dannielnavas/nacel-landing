---
// src/components/TerminalShowcase.astro
---

<div class="terminal-showcase-container">
  <div class="terminal-showcase" id="terminal-demo">
    <div class="terminal-header">
      <div class="terminal-controls">
        <span class="control-dot red"></span>
        <span class="control-dot yellow"></span>
        <span class="control-dot green"></span>
      </div>
      
      <!-- Terminal Mode Tabs -->
      <div class="terminal-tabs" role="tablist">
        <button class="terminal-tab active" role="tab" aria-selected="true" data-tab="fix" id="tab-fix">
          <span class="tab-shortcut font-mono">Ctrl+G</span>
          <span class="tab-name font-mono">fix</span>
        </button>
        <button class="terminal-tab" role="tab" aria-selected="false" data-tab="ask" id="tab-ask">
          <span class="tab-shortcut font-mono">nacel</span>
          <span class="tab-name font-mono">ask</span>
        </button>
        <button class="terminal-tab" role="tab" aria-selected="false" data-tab="hardware" id="tab-hardware">
          <span class="tab-shortcut font-mono">audit</span>
          <span class="tab-name font-mono">hardware</span>
        </button>
        <button class="terminal-tab" role="tab" aria-selected="false" data-tab="chat" id="tab-chat">
          <span class="tab-shortcut font-mono">interactive</span>
          <span class="tab-name font-mono">chat</span>
        </button>
      </div>

      <div class="terminal-telemetry font-mono">
        <span class="telemetry-badge">OLLAMA LOCAL</span>
      </div>
    </div>

    <!-- Tab Content Panes -->
    <div class="terminal-body font-mono">
      
      <!-- Pane 1: fix (Ctrl+G) -->
      <div class="tab-pane active" id="pane-fix">
        <div class="t-line input-line">
          <span class="t-prompt">danniel@dev-mbp ~/repo %</span>
          <span class="t-cmd">git push origin main</span>
        </div>
        <div class="t-line error-line">
          <span class="t-err-prefix">To github.com:dannielnavas/nacel.git</span>
        </div>
        <div class="t-line error-line">
          <span class="t-err">! [rejected] main -&gt; main (fetch first)</span>
        </div>
        <div class="t-line error-line muted">
          <span>error: failed to push some refs to 'github.com:dannielnavas/nacel.git'</span>
        </div>
        <div class="t-line error-line muted">
          <span>hint: Updates were rejected because the remote contains work that you do not have locally.</span>
        </div>

        <!-- Nacel Intervention -->
        <div class="nacel-aperture-trigger">
          <div class="aperture-badge">
            <span class="aperture-dot"></span>
            <span class="aperture-title">NACEL COPILOT [Ctrl+G ACTIVADO]</span>
          </div>
          <div class="aperture-diagnosis">
            <span class="diag-label">⚡ Diagnóstico:</span>
            <span class="diag-text" data-i18n="demo_fix_diag">La rama remota origin/main tiene commits no integrados en local. Se requiere rebase para preservar historial limpio.</span>
          </div>
          <div class="aperture-fix-action">
            <span class="fix-prompt">&gt; Comando Sugerido:</span>
            <code class="fix-command">git pull --rebase origin main &amp;&amp; git push origin main</code>
            <button type="button" class="fix-execute-btn" id="btn-run-fix" data-i18n="demo_fix_btn">
              <span>↵ Presionar Enter para aplicar</span>
            </button>
          </div>
          <div class="aperture-success-log" id="fix-success-log" style="display: none;">
            <span class="success-text">✔ Successfully rebased and updated refs/heads/main. Everything up-to-date!</span>
          </div>
        </div>
      </div>

      <!-- Pane 2: ask "consulta" -->
      <div class="tab-pane" id="pane-ask">
        <div class="t-line input-line">
          <span class="t-prompt">danniel@dev-mbp ~/repo %</span>
          <span class="t-cmd">nacel ask "buscar archivos mayores a 500MB en /var/log y ordenarlos"</span>
        </div>
        <div class="nacel-aperture-trigger">
          <div class="aperture-badge">
            <span class="aperture-dot"></span>
            <span class="aperture-title">NACEL SYNTAX TRANSLATOR</span>
          </div>
          <div class="aperture-diagnosis">
            <span class="diag-label">⚡ Sintaxis Generada:</span>
            <code class="fix-command">find /var/log -type f -size +500M -exec ls -lh {{}} + | sort -k 5 -hr</code>
          </div>
          <div class="aperture-explanation">
            <p class="diag-text" data-i18n="demo_ask_expl">
              • <strong>find /var/log -type f</strong>: rastrea únicamente archivos regulares.<br />
              • <strong>-size +500M</strong>: filtra elementos con volumen estricto superior a 500 Megabytes.<br />
              • <strong>sort -k 5 -hr</strong>: ordena por la quinta columna (tamaño) en orden descendente legible.
            </p>
          </div>
        </div>
      </div>

      <!-- Pane 3: hardware -->
      <div class="tab-pane" id="pane-hardware">
        <div class="t-line input-line">
          <span class="t-prompt">danniel@dev-mbp ~/repo %</span>
          <span class="t-cmd">nacel hardware</span>
        </div>
        <div class="hardware-audit-stream">
          <div class="audit-block">
            <div class="audit-header">--- AUDITORÍA DE ARQUITECTURA DEL SISTEMA ---</div>
            <div class="audit-metric">
              <span class="m-key">Plataforma:</span>
              <span class="m-val">macOS Sonoma 14.5 (Darwin 23.5.0)</span>
            </div>
            <div class="audit-metric">
              <span class="m-key">Procesador:</span>
              <span class="m-val">Apple M3 Max (16 Cores • 12 Performance + 4 Efficiency)</span>
            </div>
            <div class="audit-metric">
              <span class="m-key">Memoria RAM:</span>
              <span class="m-val">36 GB LPDDR5 (Unificada • 300 GB/s de ancho de banda)</span>
            </div>
            <div class="audit-metric">
              <span class="m-key">Acelerador IA:</span>
              <span class="m-val highlight">Apple Metal Compute Engine (40-core GPU activa)</span>
            </div>
            <div class="audit-metric">
              <span class="m-key">Daemon Ollama:</span>
              <span class="m-val ok">Conectado en http://127.0.0.1:11434 (Latencia 0.4ms)</span>
            </div>
          </div>
          <div class="audit-result-banner">
            <div class="res-title">⚡ CONFIGURACIÓN ÓPTIMA ASIGNADA:</div>
            <div class="res-body">
              <span class="res-model">qwen2.5-coder:7b</span>
              <span class="res-quant">(Q4_K_M • 4.7 GB VRAM)</span>
            </div>
            <div class="res-foot">
              <span>Velocidad de Inferencia: <strong>78.4 tokens/segundo</strong> • Cero Estrés Térmico</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Pane 4: chat -->
      <div class="tab-pane" id="pane-chat">
        <div class="t-line input-line">
          <span class="t-prompt">danniel@dev-mbp ~/repo %</span>
          <span class="t-cmd">nacel chat "optimiza mi script de backup zsh para ignorar carpetas node_modules"</span>
        </div>
        <div class="nacel-aperture-trigger">
          <div class="aperture-badge">
            <span class="aperture-dot"></span>
            <span class="aperture-title">NACEL LOCAL REASONING ENGINE (QWEN2.5-CODER)</span>
          </div>
          <div class="chat-response-stream">
            <p class="diag-text" data-i18n="demo_chat_text">
              Aquí tienes el filtro rsync de máxima eficiencia con exclusión nativa de carpetas node_modules y ficheros temporales:
            </p>
            <pre class="code-block font-mono"><code>rsync -avz --delete \
  --exclude='node_modules/' \
  --exclude='.git/' \
  --exclude='.DS_Store' \
  "$SOURCE_DIR/" "$TARGET_DIR/"</code></pre>
            <p class="diag-subtext" data-i18n="demo_chat_note">
              ⚡ Se ejecutó en 120ms sin telemetría ni consumo de red externa.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .terminal-showcase-container {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .terminal-showcase {
    width: 100%;
    max-width: 960px;
    background: #07070a;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    text-align: left;
  }

  .terminal-header {
    background: #0b0c11;
    border-bottom: 1px solid var(--hairline);
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
  }

  .control-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .control-dot.red { background: #ff5f56; }
  .control-dot.yellow { background: #ffbd2e; }
  .control-dot.green { background: #27c93f; }

  .terminal-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .terminal-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-dim);
    transition: all 0.15s ease;
  }

  .terminal-tab:hover {
    color: var(--text-platinum);
    background: rgba(255, 255, 255, 0.02);
  }

  .terminal-tab.active {
    color: var(--text-pure);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--hairline-bright);
  }

  .tab-shortcut {
    color: var(--accent-cyan);
    font-size: 0.65rem;
    background: rgba(0, 242, 254, 0.08);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
  }

  .terminal-telemetry {
    font-size: 0.65rem;
  }

  .telemetry-badge {
    color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.08);
    padding: 0.2rem 0.4rem;
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 2px;
  }

  .terminal-body {
    padding: 1.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
    min-height: 320px;
  }

  .tab-pane {
    display: none;
    animation: fadeIn 0.2s ease forwards;
  }

  .tab-pane.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .t-line {
    margin-bottom: 0.35rem;
  }

  .t-prompt {
    color: var(--text-dim);
    margin-right: 0.5rem;
  }

  .t-cmd {
    color: var(--text-pure);
    font-weight: 600;
  }

  .error-line {
    color: #f87171;
  }

  .error-line.muted {
    color: #991b1b;
    font-size: 0.8rem;
  }

  .nacel-aperture-trigger {
    margin-top: 1.25rem;
    padding: 1.25rem;
    background: rgba(0, 242, 254, 0.02);
    border-left: 2px solid var(--accent-cyan);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    border-radius: 0 4px 4px 0;
  }

  .aperture-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .aperture-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-cyan);
  }

  .aperture-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
  }

  .aperture-diagnosis {
    margin-bottom: 0.75rem;
  }

  .diag-label {
    color: var(--text-pure);
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .diag-text {
    color: var(--text-platinum);
    font-size: 0.825rem;
    line-height: 1.5;
  }

  .diag-subtext {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-top: 0.5rem;
  }

  .aperture-fix-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--hairline);
  }

  .fix-prompt {
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .fix-command {
    background: #0f1017;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--hairline-bright);
    border-radius: 4px;
    color: #38bdf8;
    font-size: 0.8rem;
  }

  .fix-execute-btn {
    padding: 0.3rem 0.75rem;
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid var(--accent-cyan);
    border-radius: 4px;
    color: var(--accent-cyan);
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  .fix-execute-btn:hover {
    background: var(--accent-cyan);
    color: #000000;
  }

  .aperture-success-log {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 4px;
    color: var(--accent-emerald);
    font-size: 0.8rem;
  }

  .audit-block {
    margin-bottom: 1rem;
  }

  .audit-header {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .audit-metric {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    margin-bottom: 0.25rem;
  }

  .m-key {
    color: var(--text-dim);
    min-width: 140px;
  }

  .m-val {
    color: var(--text-platinum);
  }

  .m-val.highlight {
    color: var(--accent-cyan);
  }

  .m-val.ok {
    color: var(--accent-emerald);
  }

  .audit-result-banner {
    padding: 1rem;
    background: #0d0e15;
    border: 1px solid var(--hairline-bright);
    border-radius: 4px;
  }

  .res-title {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    margin-bottom: 0.35rem;
  }

  .res-body {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .res-model {
    font-size: 1.15rem;
    color: var(--text-pure);
    font-weight: 700;
  }

  .res-quant {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .res-foot {
    font-size: 0.75rem;
    color: var(--text-steel);
  }

  .code-block {
    background: #0b0c12;
    padding: 0.75rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    margin: 0.5rem 0;
    overflow-x: auto;
    color: #67e8f9;
    font-size: 0.8rem;
  }
</style>
