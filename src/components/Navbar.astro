---
// src/components/Navbar.astro
---

<header class="header">
  <div class="header-inner">
    <a href="#" class="brand-group" aria-label="Nacel.AI Inicio">
      <div class="brand-badge">
        <span class="pulse-indicator"></span>
        <span class="brand-spark">✨</span>
      </div>
      <div class="brand-text">
        <span class="brand-title">Nacel<span class="brand-accent">.AI</span></span>
        <span class="brand-version font-mono">v1.2.0</span>
      </div>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      <a href="#features" class="nav-item" data-i18n="nav_features">Funciones</a>
      <a href="#terminal-demo" class="nav-item" data-i18n="nav_demo">Demo Interactiva</a>
      <a href="#hardware-matrix" class="nav-item" data-i18n="nav_hardware">Modelos & Hardware</a>
      <a href="#platforms" class="nav-item" data-i18n="nav_shells">Shells</a>
      <a href="#faq" class="nav-item" data-i18n="nav_faq">FAQ</a>
    </nav>

    <div class="header-actions">
      <!-- Realtime Language Switcher -->
      <div class="lang-switcher font-mono" role="group" aria-label="Selector de idioma">
        <button type="button" class="lang-btn active" id="btn-es" data-lang-set="es">ES</button>
        <span class="lang-divider">/</span>
        <button type="button" class="lang-btn" id="btn-en" data-lang-set="en">EN</button>
      </div>

      <!-- GitHub Direct Link -->
      <a 
        href="https://github.com/dannielnavas/nacel" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="github-action-btn"
        aria-label="Ver repositorio en GitHub"
      >
        <svg class="gh-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span class="gh-text font-mono">dannielnavas/nacel</span>
        <span class="gh-tag">★ OSS</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 5, 7, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--hairline);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-badge {
    position: relative;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--hairline);
    border-radius: 4px;
  }

  .pulse-indicator {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 6px;
    height: 6px;
    background: var(--accent-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-cyan);
  }

  .brand-spark {
    font-size: 0.85rem;
  }

  .brand-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-pure);
  }

  .brand-accent {
    color: var(--accent-cyan);
  }

  .brand-version {
    font-size: 0.65rem;
    color: var(--text-dim);
    margin-left: 0.4rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--hairline);
    border-radius: 3px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  .nav-item {
    font-size: 0.85rem;
    color: var(--text-steel);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--text-pure);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--hairline);
    border-radius: 4px;
  }

  .lang-btn {
    color: var(--text-dim);
    padding: 0.1rem 0.25rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .lang-btn.active {
    color: var(--accent-cyan);
  }

  .lang-divider {
    color: var(--hairline-bright);
  }

  .github-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-platinum);
    transition: all 0.2s ease;
  }

  .github-action-btn:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--hairline-bright);
    color: var(--text-pure);
  }

  .gh-tag {
    font-size: 0.65rem;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
  }
</style>
