---
// src/pages/index.astro
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TerminalShowcase from '../components/TerminalShowcase.astro';
import Platforms from '../components/Platforms.astro';
import FeaturesStream from '../components/FeaturesStream.astro';
import HardwareMatrix from '../components/HardwareMatrix.astro';
import Faq from '../components/Faq.astro';
import CtaStrip from '../components/CtaStrip.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Comprehensive SEO, OpenGraph, Twitter, and Schema.org Structured Data -->
    <SEO />
  </head>
  <body>
    <!-- Subtle architectural ambient guides -->
    <div class="bg-grid-overlay"></div>

    <!-- Modular Navigation -->
    <Navbar />

    <!-- Main Single-Page Canvas Flow -->
    <main class="main-canvas">
      <!-- Hero Section & 1-Click Install -->
      <Hero />

      <!-- The Living Aperture Terminal Showcase -->
      <TerminalShowcase />

      <!-- Platform & Shells Laser Ticker -->
      <Platforms />

      <!-- Kinetic Asymmetric Features Stream (No Box Clichés) -->
      <FeaturesStream />

      <!-- Architectural Hardware & Models Matrix -->
      <HardwareMatrix />

      <!-- Hairline Accordion FAQ -->
      <Faq />

      <!-- Bottom Call To Action -->
      <CtaStrip />
    </main>

    <!-- Footer with Telemetry and LLM Discovery -->
    <Footer />

    <!-- Client-side Interactive Logic (i18n, Copy, Tabs, Accordion) -->
    <script is:inline>
      // Internationalization Dictionary (ES / EN)
      const i18nData = {
        es: {
          nav_features: "Funciones",
          nav_demo: "Demo Interactiva",
          nav_hardware: "Modelos & Hardware",
          nav_shells: "Shells",
          nav_faq: "FAQ",
          hero_badge: "⚡ 100% Local • Privado • Potenciado por Ollama",
          hero_title: "El Copiloto Inteligente<br /><span class=\"hero-title-highlight\">para tu Terminal.</span>",
          hero_desc: "Diagnostica comandos fallidos al instante, traduce lenguaje natural a sintaxis precisa de terminal, explica código y chatea con IA local sin enviar un solo byte a la nube.",
          copy_btn: "Copiar",
          copy_copied: "¡Copiado!",
          install_note: "⚡ Instalación en 1 clic • Compatible con macOS, Linux y WSL2",
          demo_fix_diag: "La rama remota origin/main tiene commits no integrados en local. Se requiere rebase para preservar historial limpio.",
          demo_fix_btn: "↵ Presionar Enter para aplicar",
          demo_ask_expl: "• find /var/log -type f: rastrea únicamente archivos regulares.<br />• -size +500M: filtra elementos con volumen estricto superior a 500 Megabytes.<br />• sort -k 5 -hr: ordena por la quinta columna (tamaño) en orden descendente legible.",
          demo_chat_text: "Aquí tienes el filtro rsync de máxima eficiencia con exclusión nativa de carpetas node_modules y ficheros temporales:",
          demo_chat_note: "⚡ Se ejecutó en 120ms sin telemetría ni consumo de red externa.",
          tag_platforms: "// COMPATIBILIDAD NATIVA TOTAL",
          platforms_title: "Soporte Nativo en Cada Entorno de Desarrollo",
          cat_systems: "SISTEMAS OPERATIVOS",
          cat_shells: "SHELLS NATIVAS",
          tag_architecture: "// INGENIERÍA Y CAPACIDADES",
          features_monumental_title: "Potencia Cruda en tu Shell.<br /><span class=\"text-steel\">Sin Clics. Sin Nube. Sin Esperas.</span>",
          features_subtitle: "Flujo de trabajo optimizado para desarrolladores que viven en la consola. Diseñado con latencia cero como prioridad absoluta.",
          f1_title: "Reparación Inmediata con Ctrl+G / fix",
          f1_desc: "Captura la traza exacta del último comando fallido en tu shell. En milisegundos, deduce la causa raíz en una frase quirúrgica y coloca el comando corregido listo para ser ejecutado con un simple Enter.",
          f2_title: "Lenguaje Natural a Comando (ask)",
          f2_desc: "Olvida memorizar flags oscuras de awk, find, tar o iptables. Expresa lo que necesitas en español o inglés y Nacel generará sintaxis validada para tu sistema operativo específico.",
          f3_title: "Diagnóstico Inteligente de Hardware",
          f3_desc: "Auditoría automática de núcleos CPU, memoria RAM unificada y aceleradores gráficos (Metal, CUDA o Vulkan). Nacel selecciona y auto-configura el modelo de parámetros ideal para garantizar fluidez sin asfixiar la memoria de tu máquina.",
          f4_title: "Cero Telemetría y 100% Privado",
          f4_desc: "Tus tokens, variables de entorno, rutas sensibles de carpetas y código fuente jamás abandonan tu equipo. No hay servidores intermedios, cuentas obligatorias, ni recopilación de analíticas: todo se procesa mediante tu instancia local de Ollama.",
          f5_title: "Explicación y Debugging de Código",
          f5_desc: "Diseñado para integrarse con la filosofía Unix de composición. Pasa logs caóticos o scripts sospechosos directamente a través de pipes estándar: cat error.log | nacel debug para obtener un análisis inmediato del problema.",
          f6_title: "Bilingüe Nativo (ES / EN)",
          f6_desc: "Tanto la interfaz en consola como el razonamiento y las explicaciones de la IA se adaptan con fidelidad nativa al idioma que elijas. Conmuta instantáneamente la experiencia con el comando nacel lang es o nacel lang en.",
          tag_matrix: "// MATRIZ DE ASIGNACIÓN INTELIGENTE",
          matrix_title: "Hardware Detectado vs. Modelo Recomendado",
          matrix_desc: "Nacel audita los recursos disponibles y vincula el modelo que ofrece el equilibrio perfecto entre exactitud técnica y consumo mínimo de memoria.",
          th_hardware: "Hardware Detectado",
          th_model: "Modelo Asignado",
          th_performance: "Rendimiento",
          th_usecase: "Caso de Uso",
          uc_1: "Copiloto principal para desarrollo intensivo, arquitectura de software y scripts complejos.",
          uc_2: "Comandos diarios de Git, Docker, Kubernetes y corrección precisa de errores de consola.",
          uc_3: "Respuestas inmediatas de sintaxis sin saturar la memoria RAM del sistema operativo.",
          uc_4: "Sugerencias rápidas y correcciones en máquinas con recursos de hardware limitados.",
          tag_faq: "// RESOLUCIÓN DE DUDAS FRECUENTES",
          faq_title: "Preguntas Frecuentes",
          faq_q1: "¿Necesito internet para usar Nacel?",
          faq_a1: "Solo necesitas conexión a internet durante la instalación inicial para descargar el script y obtener el modelo de Ollama en tu equipo. Una vez completado, Nacel funciona de manera <strong>100% offline</strong> en aviones, trenes o centros de datos aislados sin conexión externa.",
          faq_q2: "¿Qué shells están soportadas oficialmente?",
          faq_a2: "Zsh (incluyendo Oh My Zsh, Zinit y Antigen), Fish Shell (con soporte Fisher y conf.d), GNU Bash (mediante hooks en PROMPT_COMMAND) y entornos compatibles POSIX en macOS, distribuciones Linux (Arch, Ubuntu, Fedora, Debian) y WSL2.",
          faq_q3: "¿Cómo se actualiza Nacel a la última versión?",
          faq_a3: "Basta con volver a ejecutar el comando de instalación de una sola línea curl -fsSL https://raw.githubusercontent.com/dannielnavas/nacel/main/install.sh | bash o bien hacer git pull dentro de tu repositorio local clonado.",
          faq_q4: "¿Puedo cambiar de modelo de IA en cualquier momento?",
          faq_a4: "Sí. Puedes cambiar de modelo manualmente con nacel model set <nombre> (por ejemplo nacel model set codellama:7b) o ejecutar interactivamente nacel model recommend para que el sistema re-evalúe la carga actual de tu hardware.",
          cta_title: "Toma el control de tu terminal hoy mismo.",
          cta_desc: "Instalación no intrusiva. Sin cuentas de usuario. Desinstalación limpia en un solo comando.",
          cta_badge: "Copiar",
          footer_rights: "Creado por <strong>Danniel Navas</strong>. Código liberado bajo Licencia MIT Open Source."
        },
        en: {
          nav_features: "Features",
          nav_demo: "Interactive Demo",
          nav_hardware: "Models & Hardware",
          nav_shells: "Shells",
          nav_faq: "FAQ",
          hero_badge: "⚡ 100% Local • Private • Powered by Ollama",
          hero_title: "The Intelligent Copilot<br /><span class=\"hero-title-highlight\">for your Terminal.</span>",
          hero_desc: "Instantly diagnose failed commands, translate natural language into exact shell syntax, explain code, and chat with local AI without sending a single byte to the cloud.",
          copy_btn: "Copy",
          copy_copied: "Copied!",
          install_note: "⚡ 1-click installation • Compatible with macOS, Linux, and WSL2",
          demo_fix_diag: "Remote branch origin/main contains unmerged commits. Rebase required to preserve a clean commit tree.",
          demo_fix_btn: "↵ Press Enter to apply",
          demo_ask_expl: "• find /var/log -type f: matches regular files only.<br />• -size +500M: strictly filters files exceeding 500 Megabytes.<br />• sort -k 5 -hr: sorts by 5th column (size) in human-readable descending order.",
          demo_chat_text: "Here is your high-efficiency rsync backup command with native exclusion of node_modules and temporary dotfiles:",
          demo_chat_note: "⚡ Executed in 120ms with zero telemetry and zero external network calls.",
          tag_platforms: "// TOTAL NATIVE COMPATIBILITY",
          platforms_title: "Native Support Across Every Development Environment",
          cat_systems: "OPERATING SYSTEMS",
          cat_shells: "NATIVE SHELLS",
          tag_architecture: "// ENGINEERING & CAPABILITIES",
          features_monumental_title: "Raw Power in your Shell.<br /><span class=\"text-steel\">No Clicks. No Cloud. Zero Latency.</span>",
          features_subtitle: "Workflow designed for developers who live inside the terminal. Built from scratch with zero latency as the top priority.",
          f1_title: "Instant Fix with Ctrl+G / fix",
          f1_desc: "Captures the exact trace of the last failed shell command. In milliseconds, it diagnoses the root cause in one surgical sentence and autofills the corrected command ready for Enter.",
          f2_title: "Natural Language to Shell (ask)",
          f2_desc: "Forget memorizing obscure flags for awk, find, tar, or iptables. State your goal in English or Spanish and Nacel generates verified syntax tailored to your specific OS.",
          f3_title: "Intelligent Hardware Audit",
          f3_desc: "Automated audit of CPU cores, unified RAM, and graphics accelerators (Metal, CUDA, or Vulkan). Nacel picks and configures the optimal parameter model for maximum fluency without choking RAM.",
          f4_title: "Zero Telemetry & 100% Private",
          f4_desc: "Your tokens, environment variables, sensitive paths, and codebase never leave your machine. No proxy servers, no mandatory accounts, no telemetry collection: fully local via Ollama.",
          f5_title: "Code Explanation & Pipe Debugging",
          f5_desc: "Built to honor the Unix philosophy of tool chaining. Pipe cryptic logs or questionable scripts directly through standard input: cat error.log | nacel debug for immediate clarity.",
          f6_title: "Native Bilingual (ES / EN)",
          f6_desc: "Both the CLI terminal UI and the model's analytical reasoning natively adapt to your language of choice. Switch instantaneously using nacel lang es or nacel lang en.",
          tag_matrix: "// SMART ASSIGNMENT MATRIX",
          matrix_title: "Detected Hardware vs. Recommended Model",
          matrix_desc: "Nacel audits available system resources and couples the exact model offering surgical precision with negligible footprint.",
          th_hardware: "Detected Hardware",
          th_model: "Assigned Model",
          th_performance: "Performance",
          th_usecase: "Use Case",
          uc_1: "Primary copilot for heavy development, software architecture, and complex shell scripts.",
          uc_2: "Daily Git, Docker, Kubernetes commands and high-speed terminal error correction.",
          uc_3: "Instantaneous syntax translations with lightweight RAM footprint on standard hardware.",
          uc_4: "Instant suggestions and rapid diagnostics on constrained hardware or lightweight netbooks.",
          tag_faq: "// FREQUENTLY ASKED QUESTIONS",
          faq_title: "Frequently Asked Questions",
          faq_q1: "Do I need an internet connection to use Nacel?",
          faq_a1: "You only need internet during initial setup to pull the install script and the selected Ollama model weights. Once finished, Nacel runs <strong>100% offline</strong> on airplanes, trains, or air-gapped data centers.",
          faq_q2: "Which shells are officially supported?",
          faq_a2: "Zsh (including Oh My Zsh, Zinit, and Antigen), Fish Shell (with Fisher and conf.d integration), GNU Bash (via PROMPT_COMMAND hooks), and POSIX environments across macOS, Linux distros, and WSL2.",
          faq_q3: "How do I update Nacel to the latest release?",
          faq_a3: "Simply re-run the 1-click install command curl -fsSL https://raw.githubusercontent.com/dannielnavas/nacel/main/install.sh | bash or perform git pull inside your cloned repository.",
          faq_q4: "Can I swap the underlying AI model at any time?",
          faq_a4: "Yes. Swap models manually with nacel model set <name> (e.g. nacel model set codellama:7b) or run nacel model recommend interactively to re-evaluate system hardware under current workload.",
          cta_title: "Take command of your terminal today.",
          cta_desc: "Non-intrusive installation. No user accounts. Clean uninstallation in a single command.",
          cta_badge: "Copy",
          footer_rights: "Built by <strong>Danniel Navas</strong>. Open-source under MIT License."
        }
      };

      let currentLang = 'es';

      function updateLanguage(lang) {
        currentLang = lang;
        document.documentElement.lang = lang;
        const dict = i18nData[lang];
        if (!dict) return;

        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (dict[key]) {
            el.innerHTML = dict[key];
          }
        });

        // Update active buttons
        document.querySelectorAll('.lang-btn').forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-lang-set') === lang);
        });

        localStorage.setItem('nacel_lang', lang);
      }

      // Initialize language
      const savedLang = localStorage.getItem('nacel_lang') || 'es';
      updateLanguage(savedLang);

      document.getElementById('btn-es')?.addEventListener('click', () => updateLanguage('es'));
      document.getElementById('btn-en')?.addEventListener('click', () => updateLanguage('en'));

      // Copy Install Command logic
      const copyBtn = document.getElementById('copy-btn');
      const copyLabel = document.getElementById('copy-label');
      const installCmd = document.getElementById('install-cmd');

      async function performCopy(btn, labelEl, textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          const original = labelEl.textContent;
          labelEl.textContent = currentLang === 'es' ? '¡Copiado!' : 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            labelEl.textContent = original;
            btn.classList.remove('copied');
          }, 2200);
        } catch (e) {
          console.error('Copy failed:', e);
        }
      }

      copyBtn?.addEventListener('click', () => {
        if (installCmd) performCopy(copyBtn, copyLabel, installCmd.textContent.trim());
      });

      const ctaBtn = document.getElementById('btn-cta-copy');
      const ctaBadge = document.getElementById('cta-copy-badge');
      ctaBtn?.addEventListener('click', () => {
        if (installCmd) performCopy(ctaBtn, ctaBadge, installCmd.textContent.trim());
      });

      // Terminal Tab Switcher
      const tabs = document.querySelectorAll('.terminal-tab');
      const panes = document.querySelectorAll('.tab-pane');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          panes.forEach((p) => p.classList.remove('active'));

          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          const target = tab.getAttribute('data-tab');
          const targetPane = document.getElementById(`pane-${target}`);
          if (targetPane) targetPane.classList.add('active');
        });
      });

      // Fix action simulation
      const runFixBtn = document.getElementById('btn-run-fix');
      const fixSuccessLog = document.getElementById('fix-success-log');
      runFixBtn?.addEventListener('click', () => {
        if (fixSuccessLog) {
          fixSuccessLog.style.display = 'block';
          runFixBtn.style.opacity = '0.5';
          runFixBtn.style.pointerEvents = 'none';
          runFixBtn.innerHTML = '<span>✔ Ejecutado con éxito</span>';
        }
      });

      // FAQ Accordion
      const faqTriggers = document.querySelectorAll('.faq-trigger');
      faqTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const item = trigger.closest('.faq-item');
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

          // Close other items
          faqTriggers.forEach((t) => {
            t.setAttribute('aria-expanded', 'false');
            t.closest('.faq-item')?.classList.remove('active');
            const ind = t.querySelector('.faq-indicator');
            if (ind) ind.textContent = '+';
          });

          if (!isExpanded) {
            trigger.setAttribute('aria-expanded', 'true');
            item?.classList.add('active');
            const ind = trigger.querySelector('.faq-indicator');
            if (ind) ind.textContent = '−';
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .main-canvas {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>
